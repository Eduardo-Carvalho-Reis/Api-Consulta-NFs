{
  "name": "api-notas-fiscais",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "postinstall": "node scripts/patch-danfe.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "empresa": "node scripts/empresa.js",
    "token": "node scripts/token.js",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node scripts/test-integration.js",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "@alexssmusica/node-pdf-nfe": "1.3.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "asn1js": "3.0.10",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "fast-xml-parser": "5.11.2",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "xmllint-wasm": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "pdfjs-dist": "6.4.299",
    "prisma": "7.10.0",
    "supertest": "7.3.1"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  }
}
