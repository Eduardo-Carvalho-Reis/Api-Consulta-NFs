# Node 24 / PostgreSQL 18. Copie para .env e preencha localmente.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/notas_fiscais?schema=public
# Gere um segredo aleatório de pelo menos 32 bytes. Não reutilize este comentário.
JWT_SECRET=
JWT_ISSUER=api-notas-fiscais
JWT_AUDIENCE=api-notas-fiscais
# 2 = homologação; 1 = produção. Use bancos e storage distintos por ambiente.
SEFAZ_AMBIENTE=2
EMPRESA_NOME=
EMPRESA_CNPJ=
EMPRESA_UF_AUTOR=35
EMPRESA_ATIVA=false
# São nomes de variáveis, não os segredos; somente os nomes vão para o banco.
EMPRESA_CERT_PATH_ENV=CERTIFICADO_PATH
EMPRESA_CERT_SENHA_ENV=CERTIFICADO_SENHA
CERTIFICADO_PATH=
CERTIFICADO_SENHA=
# OpenSSL 3 no PATH ou caminho absoluto. Windows: detecta o OpenSSL do Git.
OPENSSL_BIN=
SYNC_ENABLED=false
SYNC_INTERVAL_MS=3600000
SYNC_MAX_BATCHES=10
SEFAZ_TIMEOUT_MS=30000
STORAGE_DIR=./storage/notas-fiscais
LOG_LEVEL=info
# CLI para emitir token. Escopos e CNPJs separados por vírgula.
TOKEN_SUBJECT=operador-local
TOKEN_CNPJS=
TOKEN_SCOPES=notas:ler,notas:download,notas:sincronizar,notas:gerar,empresas:ler
TOKEN_TTL_SECONDS=3600
# Opcional: testes isolados, nunca informar credenciais de produção aqui.
# PG_BIN=C:/Program Files/PostgreSQL/18/bin
